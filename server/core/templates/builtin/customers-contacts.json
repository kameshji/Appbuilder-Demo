{
  "format": "appbuilder/template",
  "formatVersion": 1,
  "id": "builtin.customers-contacts",
  "version": "1.0.0",
  "kind": "dataModel",
  "name": "Customers, contacts and activities",
  "description": "Three related tables: customers, the people you deal with at each customer, and the calls, meetings, emails and notes you log against them. Optional SAMPLE rows show how they fit together.",
  "publisher": "Appbuilder",
  "tags": [
    "customers",
    "contacts",
    "activities",
    "crm"
  ],
  "minPlatformVersion": "0.6.0",
  "modes": [
    "copy",
    "linked"
  ],
  "slots": [
    {
      "id": "Customers",
      "label": "Customers",
      "description": "One row per customer (a company or a person you sell to).",
      "required": true,
      "defaultMode": "create",
      "create": {
        "name": "Customers",
        "displayName": "Customers",
        "primaryColumn": "Name"
      },
      "columns": [
        {
          "id": "Name",
          "label": "Name",
          "types": [
            "text"
          ],
          "required": true,
          "create": {
            "type": "text",
            "required": true
          }
        },
        {
          "id": "Industry",
          "label": "Industry",
          "types": [
            "choice",
            "text"
          ],
          "required": false,
          "create": {
            "type": "choice",
            "choices": [
              "Manufacturing",
              "Retail",
              "Services",
              "Other"
            ]
          }
        },
        {
          "id": "Phone",
          "label": "Phone",
          "types": [
            "phone",
            "text"
          ],
          "required": false,
          "create": {
            "type": "phone"
          }
        },
        {
          "id": "Website",
          "label": "Website",
          "types": [
            "url",
            "text"
          ],
          "required": false,
          "create": {
            "type": "url"
          }
        },
        {
          "id": "City",
          "label": "City",
          "types": [
            "text"
          ],
          "required": false,
          "create": {
            "type": "text"
          }
        }
      ]
    },
    {
      "id": "Contacts",
      "label": "Contacts",
      "description": "People at a customer.",
      "required": true,
      "defaultMode": "create",
      "create": {
        "name": "Contacts",
        "displayName": "Contacts",
        "primaryColumn": "FullName"
      },
      "columns": [
        {
          "id": "FullName",
          "label": "Full name",
          "types": [
            "text"
          ],
          "required": true,
          "create": {
            "type": "text",
            "required": true
          }
        },
        {
          "id": "Email",
          "label": "Email",
          "types": [
            "email",
            "text"
          ],
          "required": false,
          "create": {
            "type": "email"
          }
        },
        {
          "id": "Phone",
          "label": "Phone",
          "types": [
            "phone",
            "text"
          ],
          "required": false,
          "create": {
            "type": "phone"
          }
        },
        {
          "id": "Customer",
          "label": "Customer",
          "types": [
            "lookup"
          ],
          "lookupSlot": "Customers",
          "required": true,
          "create": {
            "type": "lookup",
            "required": true,
            "onDelete": "restrict"
          }
        }
      ]
    },
    {
      "id": "Activities",
      "label": "Customer activities",
      "description": "Calls, meetings, emails and notes about a customer.",
      "required": true,
      "defaultMode": "create",
      "create": {
        "name": "CustomerActivities",
        "displayName": "Customer activities",
        "primaryColumn": "Subject"
      },
      "columns": [
        {
          "id": "Subject",
          "label": "Subject",
          "types": [
            "text"
          ],
          "required": true,
          "create": {
            "type": "text",
            "required": true
          }
        },
        {
          "id": "Kind",
          "label": "Kind",
          "types": [
            "choice",
            "text"
          ],
          "required": true,
          "create": {
            "type": "choice",
            "choices": [
              "Call",
              "Meeting",
              "Email",
              "Note"
            ],
            "default": "Call"
          }
        },
        {
          "id": "Date",
          "label": "Date",
          "types": [
            "datetime",
            "date"
          ],
          "required": false,
          "create": {
            "type": "datetime"
          }
        },
        {
          "id": "Customer",
          "label": "Customer",
          "types": [
            "lookup"
          ],
          "lookupSlot": "Customers",
          "required": true,
          "create": {
            "type": "lookup",
            "required": true,
            "onDelete": "cascade"
          }
        },
        {
          "id": "Contact",
          "label": "Contact",
          "types": [
            "lookup"
          ],
          "lookupSlot": "Contacts",
          "required": false,
          "create": {
            "type": "lookup",
            "onDelete": "setBlank"
          }
        },
        {
          "id": "Notes",
          "label": "Notes",
          "types": [
            "multiline",
            "text"
          ],
          "required": false,
          "create": {
            "type": "multiline"
          }
        }
      ],
      "events": [
        {
          "name": "A meeting has a date",
          "kind": "validation",
          "timing": "before",
          "operations": [
            "create",
            "update"
          ],
          "condition": "Slot_Activities_Kind <> \"Meeting\" || Not(IsBlank(Slot_Activities_Date))",
          "message": "A meeting needs a date.",
          "field": "Slot_Activities_Date",
          "runAs": "caller",
          "enabled": true
        }
      ]
    }
  ],
  "payload": {
    "sample": {
      "Customers": [
        {
