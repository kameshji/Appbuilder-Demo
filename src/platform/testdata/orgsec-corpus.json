  "shares": [
    { "tableId": "tb_prod", "rowId": "00000000-0000-7000-8000-0000000000p2", "principalType": "user", "principalId": "u_parent1", "access": "read" },
    { "tableId": "tb_prod", "rowId": "00000000-0000-7000-8000-0000000000p5", "principalType": "team", "principalId": "t_qa", "access": "update" },
    { "tableId": "tb_prod", "rowId": "00000000-0000-7000-8000-0000000000p7", "principalType": "team", "principalId": "t_other_env", "access": "update" }
  ],
  "cases": [
    { "name": "own scope (plus P5, shared with the team QA)", "user": "u_op1", "table": "Production", "op": "read", "privilege": { "read": "own" }, "expect": ["P1", "P5"] },
    { "name": "team scope: own, teammates and team-owned rows (not teams of another environment)", "user": "u_op1", "table": "Production", "op": "read", "privilege": { "read": "team" }, "expect": ["P1", "P2", "P4", "P5"] },
    { "name": "team scope without teams = own rows (plus shares)", "user": "u_sup1", "table": "Production", "op": "read", "privilege": { "read": "team" }, "expect": ["P3"] },
    { "name": "manager scope: direct reports", "user": "u_sup1", "table": "Production", "op": "read", "privilege": { "read": "manager" }, "expect": ["P1", "P3"] },
    { "name": "managerTree: whole reporting line", "user": "u_plant", "table": "Production", "op": "read", "privilege": { "read": "managerTree" }, "expect": ["P1", "P2", "P3", "P5", "P8"] },
    { "name": "manager scope of someone without reports = own", "user": "u_pack", "table": "Production", "op": "read", "privilege": { "read": "manager" }, "expect": ["P8"] },
    { "name": "managerTree with a cycle in the manager chain terminates", "user": "u_cyc_a", "table": "Production", "op": "read", "privilege": { "read": "managerTree" }, "expect": ["P6", "P7"] },
    { "name": "department scope", "user": "u_sup1", "table": "Production", "op": "read", "privilege": { "read": "department" }, "expect": ["P1", "P3"] },
    { "name": "departmentTree scope (nested two levels)", "user": "u_plant", "table": "Production", "op": "read", "privilege": { "read": "departmentTree" }, "expect": ["P1", "P2", "P3", "P5", "P8"] },
    { "name": "departmentTree from the middle of the tree", "user": "u_sup2", "table": "Production", "op": "read", "privilege": { "read": "departmentTree" }, "expect": ["P2", "P8"] },
    { "name": "department scope for a user without a department = own", "user": "u_parent2", "table": "Production", "op": "read", "privilege": { "read": "department" }, "expect": [] },
    { "name": "lookup path: Line.Supervisor = @me", "user": "u_sup2", "table": "Production", "op": "read", "privilege": { "read": "all", "rowFilter": [{ "column": "Line.Supervisor", "op": "eq", "value": "@me" }] }, "expect": ["P2", "P4", "P8"] },
    { "name": "lookup path with department code token", "user": "u_op1", "table": "Production", "op": "read", "privilege": { "read": "all", "rowFilter": [{ "column": "Line.Dept", "op": "eq", "value": "@myDepartmentCode" }] }, "expect": ["P1", "P3", "P5"] },
    { "name": "lookup path with a list token (department tree ids)", "user": "u_sup2", "table": "Production", "op": "read", "privilege": { "read": "all", "rowFilter": [{ "column": "Line.DeptId", "op": "eq", "value": "@myDepartmentTree" }] }, "expect": ["P2", "P4", "P8"] },
    { "name": "unresolved token never matches (no department)", "user": "u_parent1", "table": "Production", "op": "read", "privilege": { "read": "all", "rowFilter": [{ "column": "Line.Dept", "op": "eq", "value": "@myDepartmentCode" }] }, "expect": ["P2"] },
    { "name": "team token by code", "user": "u_sup1", "table": "Production", "op": "read", "privilege": { "read": "all", "rowFilter": [{ "column": "owner", "op": "eq", "value": "@team:QA" }] }, "expect": ["P4"] },
    { "name": "department-tree token by code", "user": "u_teach1", "table": "Lines", "op": "read", "privilege": { "read": "all", "rowFilter": [{ "column": "DeptId", "op": "eq", "value": "@departmentTree:LINE2" }] }, "expect": ["L2"] },
    { "name": "not one of my reports", "user": "u_sup1", "table": "Production", "op": "read", "privilege": { "read": "manager", "rowFilter": [{ "column": "owner", "op": "ne", "value": "@myReports" }] }, "expect": ["P3"] },
    { "name": "any-of group (OR) with a path", "user": "u_sup1", "table": "Production", "op": "read", "privilege": { "read": "all", "rowFilter": [{ "any": [{ "column": "Line.Supervisor", "op": "eq", "value": "@me" }, { "column": "Qty", "op": "ge", "value": 80 }] }] }, "expect": ["P1", "P3", "P5", "P8", "P9"] },
    { "name": "education: teacher sees students of the sections they teach (junction)", "user": "u_teach1", "table": "Students", "op": "read", "privilege": { "read": "all", "rowFilter": [{ "exists": { "table": "Enrolments", "where": [{ "column": "Student", "op": "eq", "value": "@this" }, { "column": "Section.Teacher", "op": "eq", "value": "@me" }] } }] }, "expect": ["Sam", "Lia"] },
    { "name": "education: second teacher", "user": "u_teach2", "table": "Students", "op": "read", "privilege": { "read": "all", "rowFilter": [{ "exists": { "table": "Enrolments", "where": [{ "column": "Student", "op": "eq", "value": "@this" }, { "column": "Section.Teacher", "op": "eq", "value": "@me" }] } }] }, "expect": ["Sam", "Ken"] },
    { "name": "education: parent sees own child through the guardian junction", "user": "u_parent1", "table": "Students", "op": "read", "privilege": { "read": "all", "rowFilter": [{ "exists": { "table": "Guardians", "where": [{ "column": "Student", "op": "eq", "value": "@this" }, { "column": "Parent", "op": "eq", "value": "@me" }] } }] }, "expect": ["Sam"] },
    { "name": "education: parent sees the child's attendance (correlate on a column)", "user": "u_parent1", "table": "Attendance", "op": "read", "privilege": { "read": "all", "rowFilter": [{ "exists": { "table": "Guardians", "where": [{ "column": "Student", "op": "eq", "value": "@this.Student" }, { "column": "Parent", "op": "eq", "value": "@me" }] } }] }, "expect": ["t1", "t4"] },
    { "name": "education: teacher sees attendance of own sections (one hop)", "user": "u_teach1", "table": "Attendance", "op": "read", "privilege": { "read": "all", "rowFilter": [{ "column": "Section.Teacher", "op": "eq", "value": "@me" }, { "column": "Present", "op": "eq", "value": true }] }, "expect": ["t1"] },
    { "name": "education: two hops (Attendance > Student > enrolled?) via exists in exists path", "user": "u_teach2", "table": "Attendance", "op": "read", "privilege": { "read": "all", "rowFilter": [{ "exists": { "table": "Enrolments", "where": [{ "column": "Student", "op": "eq", "value": "@this.Student" }, { "column": "Section.Teacher", "op": "eq", "value": "@me" }] } }] }, "expect": ["t1", "t3", "t4"] },
    { "name": "shares: read share is added to a user who can read the table", "user": "u_parent1", "table": "Production", "op": "read", "privilege": { "read": "own" }, "expect": ["P2"] },
    { "name": "shares: no privilege, no shared rows", "user": "u_parent1", "table": "Production", "op": "read", "privilege": { "read": "none" }, "expect": [] },
    { "name": "shares: team share with update", "user": "u_op2", "table": "Production", "op": "update", "privilege": { "read": "own", "update": "own" }, "expect": ["P2", "P5"] },
    { "name": "shares: read share does not grant update", "user": "u_parent1", "table": "Production", "op": "update", "privilege": { "read": "own", "update": "own" }, "expect": [] },
    { "name": "share privilege: owner may share own rows", "user": "u_op1", "table": "Production", "op": "share", "privilege": { "read": "own" }, "expect": ["P1"] },
    { "name": "share privilege: department scope", "user": "u_sup1", "table": "Production", "op": "share", "privilege": { "read": "own", "share": "department" }, "expect": ["P1", "P3"] },
    { "name": "rule naming a missing column grants nothing", "user": "u_plant", "table": "Production", "op": "read", "privilege": { "read": "all", "rowFilter": [{ "column": "Line.Nope", "op": "eq", "value": "x" }] }, "expect": [] },
    { "name": "path through a non-lookup column grants nothing", "user": "u_plant", "table": "Production", "op": "read", "privilege": { "read": "all", "rowFilter": [{ "column": "Batch.Name", "op": "eq", "value": "x" }] }, "expect": [] }
  ]
}
