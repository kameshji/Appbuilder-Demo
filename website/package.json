{
  "name": "appbuilder-website",
  "private": true,
  "version": "0.1.0",
  "description": "Static marketing website. Plain HTML, CSS and a little JavaScript, built by a zero-dependency Node script.",
  "type": "module",
  "license": "UNLICENSED",
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "node build.mjs",
